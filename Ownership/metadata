[entries.Ownership]
title = "Ownership: an Instantiation of the Generic Owicki-Gries Logic, with Use-After-Free Safety"
date = "TODO-YYYY-MM-DD"            # submission date
topics = [
  "Computer science/Concurrency",
  "Computer science/Programming languages/Logics",
]
abstract = """
A concrete instantiation of the generic Owicki-Gries logic (AFP entry
OwickiGries). Actions are tagged with the acting process and the abstract state
carries an ownership map. A three-rule transfer discipline (locality,
footprint, fresh acquisition) fixes how actions move ownership, abstracting the
rules of a read-copy-update (RCU) algorithm. From it we prove an exclusivity
invariant and its preservation under reachability, the reusable result that
ownership disjointness discharges interference-freedom, and a use-after-free
safety corollary: the configuration co-enabling a free with a still-pending
dereference of the same resource is unreachable. Depends only on the sibling
OwickiGries entry.
"""
