definition prog_rcuincloop_init :: "(label \<times> command) list" where
  "prog_rcuincloop_init =
  [
       ''g.1'' is Set ''rN'' (EInt 1),
       ''g.2'' is Alloc ''rrcu'' (EReg ''rN''),
       ''g.3'' is WritePtr rlx (EAdd (EReg ''rrcu'') (EInt 0)) (EInt 0),
       ''g.4'' is Alloc ''rC'' (EInt 1),
       ''g.5'' is WritePtr rlx (EReg ''rC'') (EInt 0),
       ''g.6'' is Set ''rtid'' (EInt 0),
       ''g.7'' is Alloc ''rn'' (EInt 1),
       ''g.8'' is WritePtr rlx (EAdd (EReg ''rrcu'') (EReg ''rtid'')) (EInt 1),
       ''g.9'' is Do (EEq (EReg ''rsucc'') (EInt 0))
           [
           ''g.10'' is WritePtr rlx (EAdd (EReg ''rrcu'') (EReg ''rtid'')) (EInt 0),
           ''g.11'' is WritePtr rlx (EAdd (EReg ''rrcu'') (EReg ''rtid'')) (EInt 1),
           ''g.12'' is Faa acq rel ''rs'' (EReg ''rC'') (EInt 0) \<comment> \<open>rmw_op: strong\<close>,
           ''g.13'' is ReadPtr rlx ''rv'' (EReg ''rs''),
           ''g.14'' is WritePtr rlx (EReg ''rn'') (EAdd (EReg ''rv'') (EInt 1)),
           ''g.15'' is Cas acq rel ''rsucc'' (EReg ''rC'') (EReg ''rs'') (EReg ''rn'') \<comment> \<open>rmw_op: cas\<close>
           ]
           1,
       ''g.16'' is WritePtr rlx (EAdd (EReg ''rrcu'') (EReg ''rtid'')) (EInt 0)
       ]
  "

definition prog_rcuincloop :: "(label \<times> command) list list" where
  "prog_rcuincloop = [prog_rcuincloop_init]"

